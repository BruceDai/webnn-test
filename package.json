{
  "name": "webnn-test",
  "version": "1.0.0",
  "description": "WebNN automation tests using Playwright",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "test": "playwright test",
    "format": "prettier --write \"src/**/*.js\"",
    "test:wpt": "playwright test --project=chromium-canary -- --suite=wpt",
    "test:sample": "playwright test --project=chromium-canary -- --suite=sample",
    "test:preview": "playwright test --project=chromium-canary -- --suite=preview",
    "report": "start results/index.html",
    "report-static": "start results/index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "prettier": "^3.8.3"
  },
  "keywords": [
    "webnn",
    "playwright",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "MIT"
}
